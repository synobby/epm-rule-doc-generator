# Copy this file to .env for local runs. Never commit .env.
# Leave LLM_API_KEY empty to run in demo mode (no AI calls).
# Free option: gemini (key from aistudio.google.com). Others: anthropic, groq, openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
MAX_LINES=2000
WARN_LINES=1000
LLM_TIMEOUT_SECONDS=90
