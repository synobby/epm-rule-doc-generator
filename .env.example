# Copy this file to .env for local runs. Never commit .env.
# Leave LLM_API_KEY empty to run in demo mode (no AI calls).
# Free: mistral (key from console.mistral.ai). Others: groq, gemini, openrouter, anthropic, openai
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=6000
LLM_API_KEY=
MAX_LINES=2000
WARN_LINES=1000
LLM_TIMEOUT_SECONDS=90
